+def current_observation(observation, now: datetime | None = None):
+    """Reject stale/future page captures; fresh retrieval still verifies no trip fact."""
+    if observation is None:
+        return None
+    moment = now or datetime.now(timezone.utc)
+    if not isinstance(observation, dict):
+        return unavailable("invalid_observation", moment)
+    if observation.get("status") != "available":
+        return unavailable(observation.get("unavailable_reason") or "source_unavailable", moment)
+    try:
+        dates = [observation["retrieved_at"]] + [s["retrieved_at"] for s in observation["sources"]]
+        if not observation["sources"]:
+            raise ValueError("No provenance")
+        for raw in dates:
+            retrieved = datetime.fromisoformat(raw.replace("Z", "+00:00"))
+            if retrieved.tzinfo is None:
+                raise ValueError("Timestamp lacks timezone")
+            age = (moment - retrieved).total_seconds()
+            if age < 0:
+                return unavailable("future_retrieval", moment)
+            if (age >= FRESHNESS_HOURS * 3600 or
+                    retrieved.astimezone(ZoneInfo("America/New_York")).date() !=
+                    moment.astimezone(ZoneInfo("America/New_York")).date()):
+                return unavailable("stale_retrieval", moment)
+    except (KeyError, TypeError, ValueError, AttributeError):
+        return unavailable("invalid_observation", moment)
+    return {**observation, "currentness": "unknown_for_this_trip", "operational_use": False,
+            "limits": list(STATUS_LIMITS)}
